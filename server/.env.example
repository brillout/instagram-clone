# Copy to .env to override defaults (all are optional for local dev).

# Port the API listens on (the Vite dev proxy targets 3001 by default).
PORT=3001

# Secret used to sign session JWTs. CHANGE THIS in any real deployment.
JWT_SECRET=dev-insecure-secret-change-me

# Path to the SQLite database file (relative paths resolve from server/).
DATABASE_URL=./data.db
